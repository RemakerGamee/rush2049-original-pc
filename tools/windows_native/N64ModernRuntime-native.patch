-extern "C" void osYieldThread_recomp(uint8_t * rdram, recomp_context * ctx) {
-    assert(false);
-    // osYieldThread(rdram);
+extern "C" void rush_real_osYieldThread_recomp(uint8_t * rdram, recomp_context * ctx) {
+    // Preserve the current host stack while dispatching the next ready guest.
+    const auto self = ultramodern::this_thread();
+    assert(self != NULLPTR);
+    if (!ultramodern::thread_queue_empty(rdram, ultramodern::running_queue)) {
+        const auto next = ultramodern::thread_queue_peek(rdram, ultramodern::running_queue);
+        if (TO_PTR(OSThread, next)->priority >= TO_PTR(OSThread, self)->priority) {
+            ultramodern::thread_queue_pop(rdram, ultramodern::running_queue);
+            ultramodern::schedule_running_thread(rdram, self);
+            ultramodern::resume_thread_and_wait(rdram, TO_PTR(OSThread, next));
+        }
+    }
 }
 
