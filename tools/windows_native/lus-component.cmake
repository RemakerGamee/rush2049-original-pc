option(RUSH_ENABLE_LUS_IMGUI "Enable the isolated libultraship configuration / Dear ImGui options integration" ON)
if(RUSH_ENABLE_LUS_IMGUI)
  set(RUSH_LUS_SOURCE_DIR "" CACHE PATH "Existing pinned libultraship source (no automatic platform installation)")
  if(NOT RUSH_LUS_SOURCE_DIR)
    include(FetchContent)
    FetchContent_Declare(rush_lus
      GIT_REPOSITORY https://github.com/HarbourMasters/libultraship-switch.git
      GIT_TAG cb52fcfefb73b3140f46b03195d1c10b757d49ad
      SOURCE_SUBDIR rush-config-component-only)
    FetchContent_MakeAvailable(rush_lus)
    set(RUSH_LUS_SOURCE_DIR "${rush_lus_SOURCE_DIR}")
  endif()
  execute_process(COMMAND git -C "${RUSH_LUS_SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE lus_pin OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT lus_pin STREQUAL "cb52fcfefb73b3140f46b03195d1c10b757d49ad")
    message(FATAL_ERROR "libultraship source identity does not match the reviewed pin")
  endif()
  set(lus_component "${CMAKE_BINARY_DIR}/lus-component")
  file(MAKE_DIRECTORY "${lus_component}/config" "${lus_component}/nlohmann")
  # Only Config is compiled. Keep original backend enum values, without including
  # libultraship's platform/renderer/ImGui ownership headers or linking Fast3D.
  file(READ "${RUSH_LUS_SOURCE_DIR}/src/config/Config.h" config_header)
  string(REPLACE "#include \"audio/Audio.h\"\n#include \"window/Window.h\"" "#include <map>\n#include <memory>\n#include <spdlog/spdlog.h>\nnamespace Ship { class Config; enum class AudioBackend { WASAPI, SDL }; enum class WindowBackend { DX11, DX12, GLX_OPENGL, SDL_OPENGL, SDL_METAL, GX2, BACKEND_COUNT }; }" config_header "${config_header}")
  file(WRITE "${lus_component}/config/Config.h" "${config_header}")
  file(READ "${RUSH_LUS_SOURCE_DIR}/src/config/Config.cpp" config_source)
  string(REPLACE "#include <Utils/StringHelper.h>" "#include <vector>\nnamespace { std::vector<std::string> split_key(const std::string& value,const std::string& delimiter) { std::vector<std::string> result; size_t start=0,end; while((end=value.find(delimiter,start))!=std::string::npos){result.push_back(value.substr(start,end-start));start=end+delimiter.size();}result.push_back(value.substr(start));return result;} }" config_source "${config_source}")
  string(REPLACE "StringHelper::Split" "split_key" config_source "${config_source}")
  file(WRITE "${lus_component}/config/Config.cpp" "${config_source}")
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/rt64/src/contrib/json/json.hpp" "${lus_component}/nlohmann/json.hpp" COPYONLY)
  add_library(rush_lus_config STATIC "${lus_component}/config/Config.cpp")
  target_include_directories(rush_lus_config PUBLIC "${lus_component}" "${RUSH_LUS_SOURCE_DIR}/extern/spdlog/include")
  target_compile_definitions(rush_lus_config PUBLIC NOMINMAX)
  target_link_libraries(RushWindowsRT64 PRIVATE rush_lus_config winhttp crypt32)
  target_compile_definitions(RushWindowsRT64 PRIVATE RUSH_ENABLE_LUS_IMGUI)
  add_executable(RushLusConfigCheck tools/lus-imgui-check.cpp)
  target_include_directories(RushLusConfigCheck PRIVATE tools)
  target_link_libraries(RushLusConfigCheck PRIVATE rush_lus_config)
  add_executable(RushControllerSubmissionCheck tools/controller-submission-check.cpp)
  target_include_directories(RushControllerSubmissionCheck PRIVATE tools ${SDLROOT}/include)
  target_link_libraries(RushControllerSubmissionCheck PRIVATE rush_lus_config)
  target_compile_definitions(RushControllerSubmissionCheck PRIVATE SDL_MAIN_HANDLED)
  add_executable(PortUpdateAgent WIN32 tools/port-update-agent.cpp)
  target_include_directories(PortUpdateAgent PRIVATE tools)
  target_link_libraries(PortUpdateAgent PRIVATE rush_lus_config winhttp bcrypt shell32 user32 wintrust crypt32 ole32 uuid)
  target_compile_options(PortUpdateAgent PRIVATE /utf-8)
  add_executable(RushUpdateCheck tools/rush-update-check.cpp)
  target_include_directories(RushUpdateCheck PRIVATE tools)
  target_link_libraries(RushUpdateCheck PRIVATE rush_lus_config winhttp bcrypt crypt32)
  add_executable(RushUpdateAgentCheck tools/rush-update-agent-check.cpp)
  target_include_directories(RushUpdateAgentCheck PRIVATE tools)
  target_link_libraries(RushUpdateAgentCheck PRIVATE rush_lus_config winhttp bcrypt shell32 user32 wintrust crypt32 ole32 uuid)
  target_compile_options(RushUpdateAgentCheck PRIVATE /utf-8)
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/notices")
  configure_file("${RUSH_LUS_SOURCE_DIR}/LICENSE" "${CMAKE_BINARY_DIR}/notices/libultraship-MIT.txt" COPYONLY)
  configure_file("${RUSH_LUS_SOURCE_DIR}/extern/spdlog/LICENSE" "${CMAKE_BINARY_DIR}/notices/spdlog-MIT.txt" COPYONLY)
endif()
